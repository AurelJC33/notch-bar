{
  "name": "notch-bar",
  "version": "1.0.0",
  "description": "Notch bar Windows — Pomodoro, Calendar, Tasks, Now Playing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "electron tests/electron-smoke.cjs",
    "check": "node --check main.js && node --check preload.js && node --check media-service.js && node --check updater.js && node --check renderer/app.js && node --check renderer/planner.js && node --check renderer/calendar-engine.js && node --check renderer/calendar-sources.js && node --check renderer/icons.js && node --check renderer/analytics-engine.js && node --check renderer/sound-engine.js && npm run test",
    "release": "electron-builder --win --publish always"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "ical.js": "^2.2.1",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.notchbar.app",
    "productName": "Notch Bar",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "media-service.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "media-service.ps1",
        "to": "media-service.ps1"
      },
      {
        "from": "audio-device-state.ps1",
        "to": "audio-device-state.ps1"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AurelJC33",
        "repo": "notch-bar",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
